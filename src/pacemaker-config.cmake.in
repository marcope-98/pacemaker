@PACKAGE_INIT@

set(_pacemaker_supported_components inca timer)

foreach(_comp ${pacemaker_FIND_COMPONENTS})
  if(NOT _comp IN_LIST _pacemaker_supported_components)
    set(pacemaker_FOUND False)
    set(pacemaker_NOT_FOUND_MESSAGE "Unsupported component: ${_comp}")
  endif()
  include("${CMAKE_CURRENT_LIST_DIR}/pacemaker.${_comp}-targets.cmake")
endforeach()